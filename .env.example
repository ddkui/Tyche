# --- LLM provider (TradingAgents needs at least one) ---
ANTHROPIC_API_KEY=
# Alternative providers -- set TRADINGAGENTS_LLM_PROVIDER below to match.
# GOOGLE_API_KEY=

# --- OpenBB data providers ---
# Free tier (yfinance) works with no key. Add keys below to unlock better
# fundamentals/filings coverage and higher rate limits as you need them.
FMP_API_KEY=
POLYGON_API_KEY=

# --- TradingAgents tuning (see tyche/config.py for our own layer) ---
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
# Retries on transient LLM errors, including rate limits -- already built
# into the pinned TradingAgents/langchain client: on Gemini specifically,
# a 429 (RPM exceeded) is retried with exponential backoff (1s, 2s, 4s...
# capped at 60s, with jitter) up to this many attempts, so a low free-tier
# RPM quota waits itself out instead of failing the decision outright.
# Provider-agnostic (applies to Anthropic/OpenAI/Google alike); the default
# is 5 attempts if unset -- raise it for a tight Gemini RPM limit.
# TRADINGAGENTS_LLM_MAX_RETRIES=10

# --- Alpaca (paper trading only — tyche/execution/alpaca.py refuses
# anything else regardless of this flag) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets/
ALPACA_DATA_URL=https://data.alpaca.markets/
ALPACA_PAPER=true
